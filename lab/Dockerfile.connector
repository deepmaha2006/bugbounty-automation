FROM python:3.12-slim
RUN apt-get update && apt-get install -y \
    nginx \
    iptables \
    curl \
    && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir requests cryptography
WORKDIR /app
COPY . .
COPY lab/nginx/connector-proxy.conf /etc/nginx/conf.d/default.conf
RUN mkdir -p /hydrax-waf-rules /connector-home
EXPOSE 80
