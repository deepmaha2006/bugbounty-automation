# HydraX — environment configuration (spec §26). Copy to `.env` and fill in
# real values; `.env`/`.env.*` are gitignored (never commit real secrets).
#
#   cp .env.example .env

# --- Server ------------------------------------------------------------
# Bind address/port for the API process. 0.0.0.0 is correct inside a
# container behind a reverse proxy; use 127.0.0.1 only if something else on
# the same host is fronting this with its own bind.
HYDRAX_HOST=0.0.0.0
HYDRAX_PORT=8000

# Comma-separated list of origins the frontend is actually served from.
# Never "*" — CORSMiddleware pairs this with allow_credentials=True.
HYDRAX_CORS_ORIGINS=http://localhost:8000

# Comma-separated IPs/CIDRs of reverse proxies this deployment actually sits
# behind (e.g. deploy/nginx.conf.example). Only a peer in this list is
# trusted to supply X-Forwarded-For/X-Real-IP for rate-limiting purposes —
# leave unset (the default) if not running behind a reverse proxy, since
# trusting these headers from an untrusted peer would let an attacker pick
# their own rate-limit key at will.
HYDRAX_TRUSTED_PROXY_IPS=

# Set to 1 to turn off /docs, /redoc, and /openapi.json — reduces pre-auth
# API reconnaissance surface. Leave unset if you have legitimate API
# integrators who rely on the published schema.
HYDRAX_DISABLE_API_DOCS=

# --- Database (required — no SQLite fallback) ---------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hydrax
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME

# --- Redis / Celery (Phase 5 scheduler + queue) --------------------------
HYDRAX_REDIS_URL=redis://localhost:6379/0

# --- Auth (fail-closed: the app refuses to issue/accept tokens without one
# of these — see webapp/config.py::resolve_jwt_secret) -------------------
# A real deployment MUST set HYDRAX_JWT_SECRET to a long random value
# (e.g. `openssl rand -hex 32`) and MUST NOT set HYDRAX_JWT_DEV_MODE.
HYDRAX_JWT_SECRET=
# Dev/test-only convenience: generates a throwaway in-process secret so
# tokens don't survive a restart. Never set this in staging/prod.
HYDRAX_JWT_DEV_MODE=

# Registration is closed once any user exists unless the caller supplies
# this token (as <token>@hydrax.local in the signup email field) — this is
# how a second admin/org can be provisioned after initial bootstrap.
HYDRAX_ADMIN_SIGNUP_TOKEN=

# Bootstrap admin account created on first startup if both are set.
HYDRAX_ADMIN_USERNAME=
HYDRAX_ADMIN_PASSWORD=
HYDRAX_ADMIN_EMAIL=admin@hydrax.local

# --- Company Connector job signing (Phase 8, spec §6) --------------------
# An Ed25519 private key PEM the platform signs every connector job with.
# Generate one with:
#   python3 -c "from webapp.services import connector_crypto as c; \
#     priv, pub = c.generate_keypair_pem(); print(priv)"
# Leaving this unset uses a throwaway in-process key (fine for dev; any
# enrolled connector stops trusting the platform after a restart — never
# leave this unset in staging/prod).
HYDRAX_JOB_SIGNING_PRIVATE_KEY=

# --- Alerting (Phase 9, spec §9) -----------------------------------------
HYDRAX_ALERT_COOLDOWN_MINUTES=60
HYDRAX_SMTP_HOST=
HYDRAX_SMTP_PORT=587
HYDRAX_SMTP_USERNAME=
HYDRAX_SMTP_PASSWORD=
HYDRAX_SMTP_FROM=alerts@hydrax.local
HYDRAX_SMTP_USE_TLS=1

# --- Scanning ------------------------------------------------------------
HYDRAX_MAX_CONCURRENT_SCANS=3
# "real" performs actual DNS TXT lookups / engagement-letter checks;
# anything else is a test-only shortcut — never change this in production.
HYDRAX_VERIFY_MODE=real

# --- Observability (Phase 14, spec §22) ----------------------------------
HYDRAX_LOG_LEVEL=INFO
